# Kopieren nach .env und ausfüllen. Diese Datei NIE ins Repository legen.
DOMAIN=lager.example.de
POSTGRES_PASSWORT=bitte-langes-zufallspasswort
ADMIN_BENUTZER=admin
ADMIN_PASSWORT=bitte-langes-passwort-mindestens-10-zeichen
# Schlüssel für verschlüsselte Sicherungen (NFA-04). Sicher aufbewahren: ohne ihn lässt sich keine Sicherung lesen.
BACKUP_SCHLUESSEL=bitte-langer-zufallsschluessel
# Optional
GEOAPIFY_KEY=
SCANNER_TCP_PORT=0
# Zweitort für Sicherungen auf dem Host (z. B. eingebundenes Netzlaufwerk); in der Verwaltung als /zweitort eintragen
ZWEITORT=./zweitort
# FA-40 Benachrichtigungen per E-Mail (leer = nur in der App). SMTP_TLS: direkt (465), starttls (587) oder aus
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_VON=
